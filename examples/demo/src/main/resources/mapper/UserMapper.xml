<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="example.mapper.UserMapper">
  <resultMap id="UserResult" type="example.model.User">
    <id column="id" property="id"/>
    <result column="name" property="name"/>
    <result column="age" property="age"/>
  </resultMap>
  <sql id="UserColumns">id, name, age</sql>
  <select id="findById" resultMap="UserResult">
    SELECT <include refid="UserColumns"/> FROM users WHERE id = #{id}
  </select>
  <select id="search" resultMap="UserResult">
    SELECT <include refid="UserColumns"/> FROM users
    <where>
      <if test="name != null and name != ''">AND name = #{name}</if>
      <if test="age != null">AND age &gt;= #{age}</if>
    </where>
  </select>
  <select id="findByIds" resultMap="UserResult">
    SELECT <include refid="UserColumns"/> FROM users
    <choose>
      <when test="ids != null and ids.size() > 0">
        WHERE id IN
        <foreach collection="ids" item="id" open="(" close=")" separator=",">#{id}</foreach>
      </when>
      <otherwise>WHERE 1 = 0</otherwise>
    </choose>
  </select>
</mapper>
